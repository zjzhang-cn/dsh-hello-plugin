{
	// 使用 IntelliSense 了解相关属性。 
	// 悬停以查看现有属性的描述。
	// 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"type": "node",
			"request": "launch",
			"name": "PNPM Launch DSH Web（hello-plugin patch）",
			"skipFiles": [
				"<node_internals>/**"
			],
			"runtimeExecutable": "pnpm",
			"runtimeArgs": [
				"dsh",
				"web",
				"--patch",
				"../dsh-hello-plugin/dev.patch.yml"
			],
			"cwd": "${workspaceFolder}/../deepseek-harness",
			"console": "integratedTerminal",
			"autoAttachChildProcesses": true
		},
		{
			"type": "node",
			"request": "launch",
			"name": "NODE Launch DSH Web（hello-plugin patch）",
			"skipFiles": [
				"<node_internals>/**"
			],
			"runtimeExecutable": "node",
			"runtimeArgs": [
				"--import",
				"tsx/esm",
				"apps/cli/src/bin.ts",
				"web",
				"--patch",
				"../dsh-hello-plugin/dev.patch.yml"
			],
			"env": {
				"DEBUG":"hello-plugin*"
			},
			"cwd": "${workspaceFolder}/../deepseek-harness",
			"console": "integratedTerminal",
			"autoAttachChildProcesses": true
		}
	]
}